# SlotFill configuration. Copy to .env and fill in. No real values in this file.

# Path to the SQLite state store (every send and offer is logged here)
SLOTFILL_DB=slotfill.db

# Waitlist CSV and vertical pack to use
SLOTFILL_WAITLIST=examples/waitlist.csv
SLOTFILL_PACK=packs/clinic.yaml

# Name shown in message templates as {business}
SLOTFILL_BUSINESS_NAME=Your Business

# Google Calendar adapter (optional in v0.1, see docs/setup.md)
# Path to a Google service account or OAuth credentials JSON file.
SLOTFILL_GOOGLE_CREDENTIALS=
SLOTFILL_GOOGLE_CALENDAR_ID=primary

# Email notifier (SMTP). Leave unset to use the default dry-run log notifier.
SLOTFILL_SMTP_HOST=
SLOTFILL_SMTP_PORT=587
SLOTFILL_SMTP_USER=
SLOTFILL_SMTP_PASSWORD=
SLOTFILL_SMTP_FROM=
